rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    // Collection: barbershops
    // Fields: name (string), ownerUid (string), email (string), subscriptionStatus (string), createdAt (timestamp)
    //
    // Collection: clients
    // Fields: name (string), phone (string), lastVisit (timestamp), visitCount (int), totalSpent (number), points (int), barbershopId (string)
    //
    // Collection: appointments
    // Fields: clientId (string), clientName (string), serviceName (string), price (number), startTime (timestamp), endTime (timestamp), status (string), barbershopId (string)
    //
    // Collection: products
    // Fields: name (string), price (number), stock (int), minStock (int), barbershopId (string)
    //
    // Collection: sales
    // Fields: productId (string), productName (string), quantity (int), totalPrice (number), date (timestamp), barbershopId (string)
    // ===============================================================

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(barbershopId) {
      return isAuthenticated() && (
        barbershopId == request.auth.uid || 
        get(/databases/$(database)/documents/barbershops/$(barbershopId)).data.ownerUid == request.auth.uid
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Barbershops
    match /barbershops/{barbershopId} {
      allow read: if true; 
      allow create: if isAuthenticated() && incoming().ownerUid == request.auth.uid && isValidId(barbershopId);
      allow update: if isAuthenticated() && existing().ownerUid == request.auth.uid && incoming().ownerUid == request.auth.uid;
      
      // Sub-collections
      match /clients/{clientId} {
        allow read: if isOwner(barbershopId);
        allow create: if true; 
        allow update, delete: if isOwner(barbershopId);
      }
      
      match /barbers/{barberId} {
        allow read: if true; 
        allow create, update, delete: if isOwner(barbershopId);
      }
      
      match /appointments/{appointmentId} {
        allow read: if true; 
        allow create: if true; 
        allow update, delete: if isOwner(barbershopId);
      }
      
      match /services/{serviceId} {
        allow read: if true; 
        allow write: if isOwner(barbershopId);
      }
      
      match /products/{productId} {
        allow read, write: if isOwner(barbershopId);
      }
      
      match /sales/{saleId} {
        allow read, write: if isOwner(barbershopId);
      }
    }
  }
}
